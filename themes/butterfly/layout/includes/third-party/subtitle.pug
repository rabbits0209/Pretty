- const { effect, loop, source, sub } = theme.subtitle
- let subContent = sub || new Array()

script.
  function _initTyped(strings) {
    if (!{effect}) {
      window.typed = new Typed('#subtitle', {
        strings: strings,
        startDelay: 300,
        typeSpeed: 150,
        loop: !{loop},
        backSpeed: 50
      })
    } else {
      document.getElementById('subtitle').innerHTML = strings[0]
    }
  }

  function _ensureTyped(fn) {
    if (!{effect}) {
      if (typeof Typed === 'function') fn()
      else getScript('!{url_for(theme.asset.typed)}').then(fn)
    } else {
      fn()
    }
  }

case source
  when 1
    script.
      function subtitleType() {
        fetch('https://v1.hitokoto.cn')
          .then(r => r.json())
          .then(data => {
            var sub = !{JSON.stringify(subContent)}
            sub.unshift(data.hitokoto, '出自 ' + data.from)
            _initTyped(sub)
          })
      }
      _ensureTyped(subtitleType)

  when 2
    script.
      function subtitleType() {
        getScript('https://yijuzhan.com/api/word.php?m=js').then(() => {
          var sub = !{JSON.stringify(subContent)}
          sub.unshift(str[0], '出自 ' + str[1])
          _initTyped(sub)
        })
      }
      _ensureTyped(subtitleType)

  when 3
    script.
      function subtitleType() {
        getScript('https://sdk.jinrishici.com/v2/browser/jinrishici.js').then(() => {
          jinrishici.load(result => {
            var sub = !{JSON.stringify(subContent)}
            sub.unshift(result.data.content)
            _initTyped(sub)
          })
        })
      }
      _ensureTyped(subtitleType)

  default
    - subContent = subContent.length ? subContent : new Array(config.subtitle)
    script.
      function subtitleType() {
        _initTyped(!{JSON.stringify(subContent)})
      }
      _ensureTyped(subtitleType)
