each value, title in theme.social
  - const parts = value.split('||')
  a.social-icon.faa-parent.animated-hover(href=url_for(trim(parts[0])) target="_blank" title=title === undefined ? '' : trim(title))
    if parts[1]
      - var icon_value = trim(parts[1])
      - var anima_value = parts[2] ? trim(parts[2]) : 'faa-tada'
      if icon_value.substring(0,2) === "fa"
        i.fa-fw(class=icon_value + ' ' + anima_value)
      else if icon_value.substring(0,4) === "icon"
        svg.social_icon(aria-hidden="true" class=anima_value)
          use(xlink:href='#' + icon_value)
