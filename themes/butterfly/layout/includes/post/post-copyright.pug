if theme.post_copyright.enable && page.copyright !== false
  - let author = page.copyright_author ? page.copyright_author : config.author
  - let url = page.copyright_url ? page.copyright_url : page.permalink
  - let license = page.license ? page.license : theme.post_copyright.license
  - let license_url = page.license_url ? page.license_url : theme.post_copyright.license_url
  - let displayUrl = theme.post_copyright.decode ? decodeURI(url) : url

  .lc
    .lc-title= page.title
    a.lc-url(href=url_for(url))= displayUrl
    .lc-info
      div
        .lc-label 作者
        .lc-value= author
      div
        .lc-label 发布于
        .lc-value= date(page.date, config.date_format)
      div
        .lc-label 许可协议
        .lc-value
          a(rel='noopener' target='_blank' href=url_for(license_url))= license
    i.fab.fa-creative-commons.lc-watermark
